GROQ_API_KEY="your_groq_api_key"
JDOODLE_CLIENT_ID="your_jdoodle_client_id"
JDOODLE_CLIENT_SECRET="your_jdoodle_client_secret"
SARVAM_API_KEY="your_sarvam_api_key"

# Demo APK mode: Vite embeds the JDoodle values above in the APK so JavaScript,
# Python, C++ and Java can execute without a separately deployed backend.
# Internet access is still required and the credentials can be extracted.
